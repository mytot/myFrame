# =============================================================================
# myFrame — project-wide sdkconfig defaults
#
# Per-board overrides live in devices/<board>/sdkconfig.defaults and are layered
# on top of this file by the top-level CMakeLists.txt.
#
# Target: ESP-IDF v6.1.x
# =============================================================================

CONFIG_IDF_TARGET="esp32s3"

# -----------------------------------------------------------------------------
# Memory — PSRAM is mandatory: the 800x480 framebuffer cannot fit in SRAM.
# 120 MHz is non-negotiable; at 80 MHz the panel scanout alone starves the bus.
# -----------------------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=n
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

# -----------------------------------------------------------------------------
# Flash
# -----------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M_DEFAULT=y

# -----------------------------------------------------------------------------
# FreeRTOS — two cores, 1 kHz tick (vTaskDelay(1) must be a real millisecond
# so the flash-write pacing in frame_store is accurate).
# -----------------------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_CORETIMER_0=y
CONFIG_FREERTOS_SYSTICK_USES_CCOUNT=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# -----------------------------------------------------------------------------
# Compiler — v6 treats warnings as errors by default. Keep it that way.
# -----------------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# -----------------------------------------------------------------------------
# Partition table — supplied per board via PARTITION_TABLE_CUSTOM_FILENAME.
# -----------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
# A newly written image boots as PENDING_VERIFY and must confirm (frame_ota_confirm_boot)
# or the bootloader reverts to the previous slot on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# -----------------------------------------------------------------------------
# Log
# -----------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# -----------------------------------------------------------------------------
# ESP system
# -----------------------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_PM_ENABLE=y
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=y

# -----------------------------------------------------------------------------
# LWIP / Wi-Fi
# -----------------------------------------------------------------------------
CONFIG_LWIP_NETIF_LOOPBACK=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCP_MSL=15000
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16

# -----------------------------------------------------------------------------
# NVS
# -----------------------------------------------------------------------------
CONFIG_NVS_ENCRYPT=n
CONFIG_NVS_COMPRESSION=y

# -----------------------------------------------------------------------------
# FatFS
# -----------------------------------------------------------------------------
CONFIG_FATFS_LFN=y
CONFIG_FATFS_LFN_NONE=n
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_LONG_FILENAMES=y
CONFIG_FATFS_CODEPAGE_850=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# -----------------------------------------------------------------------------
# LVGL (managed component) — RGB565, PSRAM-backed heap, single draw unit.
# The single draw unit is deliberate: LVGL's multi-draw-unit threads cannot be
# core-pinned, so a second unit would break the two-core schedule.
# -----------------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_SCREEN_TRANSP=n
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_USE_STDLIB_MALLOC=LV_STDLIB_BUILTIN
CONFIG_LV_MEM_SIZE_KILOBYTES=1536
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DPI_DEF=160
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_USE_ASSERT_OBJ=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
